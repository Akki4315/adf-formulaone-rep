{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "LookupEmail",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_adlsgen2_raw",
						"type": "DatasetReference",
						"parameters": {
							"fileName": "email.csv"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "LookupEmail",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LookupEmail').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "set_temp_email",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "temp_email",
								"value": {
									"value": "@concat(item().emails,';',variables('email_list'))",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set_email_list",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "set_temp_email",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "email_list",
								"value": {
									"value": "@variables('temp_email')",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"email_list": {
				"type": "String"
			},
			"temp_email": {
				"type": "String"
			}
		},
		"annotations": []
	}
}